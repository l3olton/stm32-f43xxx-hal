{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32 F439ZI: Launch ST-Link GDB Server",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            // "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/build/firmware.elf",
                    "symbolFileName": "${workspaceFolder}/build/firmware.elf"
                }
            ],
            "deviceName": "STM32F439ZI",
            "deviceCore": "Cortex-M4",
            "svdPath": "${workspaceFolder}/STM32F439.svd",
            "serverCubeProgPath": "${command:st-stm32-ide-debug-launch.get-programmer-path}",
            "serverInterface": "SWD",
            "serverInterfaceFrequency": "Auto",
            "serverReset": "None"
        }
    ]
}